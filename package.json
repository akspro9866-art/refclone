{
  "name": "refclone-cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cli": "./src/cli.mjs",
    "./strict": "./src/strict/index.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "description": "Windows-only evidence-gated pipeline that clones any reference video into an editable Cavalry scene through MCP, driven by an AI coding agent (Qoder, Antigravity, ZCode and friends).",
  "author": "refclone contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akspro9866-art/refclone.git"
  },
  "bugs": {
    "url": "https://github.com/akspro9866-art/refclone/issues"
  },
  "homepage": "https://github.com/akspro9866-art/refclone#readme",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "refclone": "src/cli.mjs",
    "vh": "./bin/vh.mjs"
  },
  "scripts": {
    "build": "node .github/scripts/syntax-check.mjs",
    "test": "node test/run-tests.mjs",
    "test:ci": "node test/run-tests.mjs",
    "test:live": "node integration/cavalry.integration.mjs",
    "lint": "npm run verify",
    "verify": "node .github/scripts/syntax-check.mjs && node .github/scripts/config-parity.mjs && node .github/scripts/skill-parity.mjs && node .github/scripts/privacy-scan.mjs",
    "verify:docs": "node .github/scripts/test-count.mjs",
    "test:integration": "node integration/cavalry.integration.mjs",
    "prepublishOnly": "npm run verify && npm test",
    "test:zero-slop": "node --test test/pipeline/zero-slop-pipeline.test.ts",
    "e2e:zero-slop": "node scripts/e2e-zero-slop.mjs",
    "clone:live": "node scripts/clone-live.mjs",
    "vh:edit": "node bin/vh.mjs edit",
    "vh:patch": "node bin/vh.mjs patch",
    "vh:desk": "node bin/vh.mjs desk",
    "vh:gate": "node bin/vh.mjs gate",
    "vh:check": "node bin/vh.mjs check"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "schemas",
    "tools",
    "integration",
    "docs",
    "examples",
    ".github/scripts",
    ".qoder/skills",
    ".agents/skills",
    ".agents/rules",
    "config.json",
    "config.generic-template.json",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "DECISIONS.md",
    "LESSONS.md",
    "LICENSE"
  ],
  "keywords": [
    "cavalry",
    "motion-graphics",
    "video-reproduction",
    "reference-clone",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "agentic-ide",
    "ffmpeg",
    "computer-vision",
    "animation",
    "visual-qa"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "bezier-easing": "^3.2.0",
    "cavalry-mcp": "git+https://github.com/akspro9866-art/cavalry-mcp.git#af611c71787c35203900f1e415f61f1e0f226f29",
    "pngjs": "7.0.0",
    "svg-path-commander": "^2.3.3",
    "yaml": "^2.9.1"
  }
}
