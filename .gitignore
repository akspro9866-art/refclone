node_modules/
npm-debug.log*

# CI-only sibling checkout of the stallion bridge for the e2e mock-bridge gate
# (see .github/workflows/ci.yml). Never part of a developer checkout or a release.
.ci-siblings/

# Local job evidence: measured frames, plans, renders, QA reports.
# These are large, derived from your own reference video and can contain
# copyrighted material, so they are never committed.
jobs/
.test-work/
assets/

# Same rule for the live Cavalry adapter run: its saved project, PNG sequence and
# encoded clip are evidence from your machine, not source.
integration/evidence/
*.cv
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.png
!docs/**/*.png

# Machine-local secrets and overrides
.env
.env.*
config.local.json
*.tmp

# Generated smoke-run evidence: records this machine, never shipped.
scripts/output/

# Python bytecode from local validation runs.
__pycache__/
*.pyc

# Stale test frame directories and diff output
.tmp_frames/
diff_output/
test/artifacts/
