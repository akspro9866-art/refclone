{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://refclone.local/schemas/audio-analysis.schema.json",
  "title": "Measured audio energy",
  "description": "Energy observations only; no inferred transcript, speaker identity or sound labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceHash", "present", "method", "windows", "notes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "sourceHash": { "$ref": "common.schema.json#/definitions/sourceHash" },
    "present": { "type": "boolean" },
    "method": { "type": "string", "minLength": 1 },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startSeconds", "endSeconds", "rms", "peak"],
        "properties": {
          "startSeconds": { "type": "number" },
          "endSeconds": { "type": "number" },
          "rms": { "type": "number", "minimum": 0, "description": "Measured linear RMS amplitude, not decibels." },
          "peak": { "type": "number", "minimum": 0, "description": "Measured linear absolute peak amplitude, not decibels." }
        }
      }
    },
    "notes": { "$ref": "common.schema.json#/definitions/stringList" }
  },
  "if": {
    "properties": { "present": { "const": false } },
    "required": ["present"]
  },
  "then": {
    "properties": { "windows": { "type": "array", "maxItems": 0 } }
  }
}
